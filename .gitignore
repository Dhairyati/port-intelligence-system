# =============================================================================
# Port Intelligence System — .gitignore
# =============================================================================
# Critical: this file must be committed BEFORE any large files are added.
# GitHub has a 100MB file limit and a 2GB repo limit.
# vessel_features.parquet is 9.7 GB — one accidental push breaks the repo.

# -----------------------------------------------------------------------------
# Raw AIS data — never commit (gigabytes of CSV files)
# -----------------------------------------------------------------------------
data/raw/ais/
data/raw/

# -----------------------------------------------------------------------------
# Large processed files — stay on Google Drive / local only
# These are regenerated by the Colab pipeline, not version controlled.
# -----------------------------------------------------------------------------
data/processed/vessel_features.parquet
data/processed/vessel_features_chunks/
data/processed/master_dataset_sample.csv

# -----------------------------------------------------------------------------
# Small processed files ARE committed (needed for dashboard deployment)
# Explicitly un-ignore them here so the rules above don't catch them.
# -----------------------------------------------------------------------------
!data/processed/master_dataset.parquet
!data/processed/port_features.parquet
!data/processed/external_features.parquet

# -----------------------------------------------------------------------------
# Python virtual environment
# -----------------------------------------------------------------------------
venv/
env/
.env/
ENV/
.venv/

# -----------------------------------------------------------------------------
# Python cache files
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
.pytest_cache/

# -----------------------------------------------------------------------------
# Environment variables — never commit secrets
# -----------------------------------------------------------------------------
.env
.env.local
.env.production
*.env

# -----------------------------------------------------------------------------
# Kaggle API credentials — never commit
# -----------------------------------------------------------------------------
kaggle.json
.kaggle/

# -----------------------------------------------------------------------------
# Jupyter notebook checkpoints
# -----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# -----------------------------------------------------------------------------
# OS generated files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -----------------------------------------------------------------------------
# IDE and editor files
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Build and distribution
# -----------------------------------------------------------------------------
dist/
build/
*.egg-info/
.eggs/

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
logs/

# -----------------------------------------------------------------------------
# Temporary files
# -----------------------------------------------------------------------------
*.tmp
*.temp
tmp/
temp/

# -----------------------------------------------------------------------------
# Large model files that should NOT be committed
# vessel_features chunks are intermediate pipeline artifacts
# -----------------------------------------------------------------------------
data/processed/vessel_features_chunks/

# -----------------------------------------------------------------------------
# What IS committed to GitHub (for deployment to work):
#
#   ✅ models/*.joblib             (small, needed by dashboard)
#   ✅ models/*.pkl                (small, needed by dashboard)
#   ✅ models/*.json               (tiny, needed by dashboard)
#   ✅ data/processed/master_dataset.parquet      (40 KB)
#   ✅ data/processed/port_features.parquet       (10 KB)
#   ✅ data/processed/external_features.parquet   (80 KB)
#   ✅ outputs/*.png               (charts, needed by dashboard)
#   ✅ outputs/*.csv               (metrics, needed by dashboard)
#   ✅ dashboard/                  (all dashboard code)
#   ✅ src/                        (all pipeline code)
#   ✅ config.yaml                 (project config)
#   ✅ requirements.txt            (deployment dependency list)
#   ✅ .streamlit/config.toml      (Streamlit theme)
#   ✅ notebooks/                  (Colab pipeline notebook)
#
#   ❌ data/raw/                   (gigabytes of AIS CSVs)
#   ❌ data/processed/vessel_features.parquet    (9.7 GB)
#   ❌ venv/                       (local Python environment)
#   ❌ .env                        (secrets)
#   ❌ kaggle.json                 (API credentials)
# -----------------------------------------------------------------------------